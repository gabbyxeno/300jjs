-- Jumping Routine
local function startJumping(count)
    if isJumping then return end
    isJumping = true
    local player = game.Players.LocalPlayer

    for i = 1, count do
        if not isJumping then break end

        -- Chat the number
        local word = numberWords[i]
        if word then
            game.ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(word, "All")

            -- Jump
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end

            task.wait(cooldown)
        end
    end

    isJumping = false
end

-- Stop Routine
local function stopJumping()
    isJumping = false
end

-- UI Input Box
Tab:CreateInput({
    Name = "Jump Count (1–300)",
    CurrentValue = "50",
    PlaceholderText = "Enter number of JJs",
    RemoveTextAfterFocusLost = false,
    Callback = function(txt)
        local n = tonumber(txt)
        if n and n >= 1 and n <= 300 then
            jumpCount = n
            print("[JJ] Count set to", n)
        else
            warn("[JJ] Invalid entry—must be 1 to 300")
        end
    end,
})

-- Start Button
Tab:CreateButton({
    Name = "Start Jumping Jacks",
    Callback = function()
        if jumpCount > 0 then
            startJumping(jumpCount)
        else
            warn("[JJ] Set a valid count first!")
        end
    end,
})

-- Master Stop Button
Tab:CreateButton({
    Name = "Master Stop",
    Callback = function()
        stopJumping()
        print("[JJ] Master stop triggered")
    end,
})

-- Remote Stop Listener
StopJumpingJacks.OnClientEvent:Connect(stopJumping)
